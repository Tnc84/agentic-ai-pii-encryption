# LLM — local Ollama + Mistral (default)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=mistral
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_SOFT_DETECT_ENABLED=true

# Database (SQLite default; Postgres example below)
DATABASE_URL=sqlite:///./data/pii_pipeline.db
# DATABASE_URL=postgresql+psycopg://pii:pii@127.0.0.1:5432/pii_pipeline
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Pipeline limits
MAX_GRAPH_STEPS=20
MAX_RESCAN_RETRIES=2
MAX_INPUT_CHARS=50000
ESCALATE_ON_LOW_CONFIDENCE=true
PII_CONFIDENCE_THRESHOLD=0.7

# PII policy
PII_ENTITY_TYPES=EMAIL,PHONE,PERSON,ADDRESS,IBAN,CNP,CREDIT_CARD
PRESIDIO_ENABLED=true
PRESIDIO_LANGUAGE=en

# Vault / crypto (required for seal/deanonymize)
VAULT_PASSPHRASE=change-me-in-production

# Artifacts
ARTIFACTS_DIR=./artifacts

# Logging
LOG_LEVEL=INFO
LOG_JSON=true
LOG_PROMPTS=false
